{
  "name": "ci-cd-reliability-monitor",
  "version": "1.0.0",
  "description": "Echo — CI/CD reliability monitor. Every failure leaves a signal.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/db/migrate-run.ts",
    "dashboard": "npm run dev --prefix web",
    "demo": "tsx scripts/demo.ts",
    "db:status": "tsx scripts/status.ts",
    "clerk:grant": "tsx scripts/clerk-grant.ts",
    "test": "node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/backend": "^3.16.11",
    "fast-xml-parser": "^5.11.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
