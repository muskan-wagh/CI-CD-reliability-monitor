# GitHub webhook verification secret (must match the secret configured
# in your GitHub App settings). Generate a long random value, e.g.:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=dev-secret

# HTTP server
PORT=3000
HOST=0.0.0.0

# PostgreSQL (Supabase) connection string
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── Dashboard auth (Clerk) ───────────────────────────────────────────────
# The dashboard uses Clerk for sign-in/sign-up and multi-tenant access.
#  1. Create an app at https://clerk.com and copy both keys.
#  2. Put NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY in web/.env.local
#     (the frontend requires them).
#  3. Put CLERK_SECRET_KEY here as well so the API can verify forwarded
#     session tokens. When unset locally, the API runs in UNAUTHENTICATED
#     "dev" mode (all data visible).
# Map users -> GitHub App installations with: npm run clerk:grant
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── AI failure investigation (Phase D/E) ────────────────────────────────
# Provider abstraction: AI Investigation Service → Provider Adapter → LLM.
# OpenRouter is an OpenAI-compatible gateway to many models (incl. free tiers):
#   1. Create a key at https://openrouter.ai/settings/keys
#   2. Pick a model id from https://openrouter.ai/models (e.g. a ":free" tier)
# The key stays server-side and is NEVER sent to the browser or logged.
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
# Optional override (default shown):
# AI_BASE_URL=https://openrouter.ai/api/v1
# Auto-investigate when a test crosses into flaky/critical/broken.
# Cached by evidence context, so identical situations are never re-billed.
AI_AUTO_INVESTIGATE=false

# ── Phase 5: PR comments (optional — annotation disabled when unset) ──
# From your GitHub App settings: App ID, and a generated private key (.pem)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./dev.pem
# Public dashboard base URL, linked from PR comments
DASHBOARD_URL=
